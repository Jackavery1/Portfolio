# Copier vers .env.local pour surcharger au build (non versionné).
# Valeurs par défaut : build/config-defaults.cjs (sync → js/config/defaults.js).

# URL publique du site (sans slash final)
PORTFOLIO_SITE_URL=https://votre-compte.github.io/Portfolio

# Endpoint Formspree (public)
PORTFOLIO_FORMSPREE_ENDPOINT=https://formspree.io/f/votre-id

# Clé SITE reCAPTCHA uniquement (publique — jamais la clé secrète Formspree)
PORTFOLIO_RECAPTCHA_SITE_KEY=votre-cle-site-recaptcha
