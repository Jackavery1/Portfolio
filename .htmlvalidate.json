{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "void-style": "off",
    "doctype-style": "off",
    "no-utf8-bom": "off",
    "no-redundant-role": "off",
    "attribute-allowed-values": "off",
    "element-permitted-content": "off",
    "aria-label-misuse": "off",
    "no-implicit-button-type": "warn",
    "require-sri": "off",
    "close-order": "off",
    "element-name": "off",
    "no-self-closing": "off",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h36": "error",
    "wcag/h37": "error",
    "wcag/h67": "error",
    "wcag/h71": "error"
  }
}
