{
  "name": "portfolio-arcade",
  "version": "1.0.2",
  "description": "Portfolio arcade personnel — build + optimize + deploy",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node build/sync-defaults.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun",
    "validate:html": "html-validate *.html partials/*.html"
  },
  "keywords": [
    "portfolio",
    "arcade",
    "developer"
  ],
  "author": "Joris",
  "license": "UNLICENSED",
  "dependencies": {
    "clean-css": "^5.3.3",
    "sharp": "^0.34.4",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "html-validate": "^9.7.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.0",
    "serve": "^14.2.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "http-cache-semantics": "^4.1.1",
    "semver-regex": "^4.0.5",
    "got": "^11.8.6",
    "tmp": ">=0.2.6"
  }
}
