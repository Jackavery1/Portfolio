{
  "name": "portfolio-arcade",
  "version": "1.0.5",
  "description": "Portfolio arcade personnel — build + optimize + deploy",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node build.js",
    "measure": "node scripts/measure-bundle.mjs",
    "icons:optimize": "node scripts/icons-optimize.mjs",
    "watch": "node build.js --watch",
    "prestart": "node build/sync-source.cjs",
    "start": "serve .",
    "start:prod": "serve .dist-staging",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "node build/sync-source.cjs",
    "pretest": "node build/sync-source.cjs && node build/sync-page-meta.cjs --check",
    "prebuild": "node build/sync-fonts.cjs && node build/sync-source.cjs && node build/sync-pwa-icons.cjs && node scripts/icons-optimize.mjs",
    "prevalidate:html": "node build/sync-source.cjs && node build/sync-page-meta.cjs --check",
    "sync:page-meta": "node build/sync-page-meta.cjs",
    "check:page-meta": "node build/sync-page-meta.cjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:webkit": "playwright install --with-deps webkit && playwright test --project=responsive-webkit",
    "test:lhci": "lhci autorun --config=./lighthouserc.cjs",
    "validate:html": "html-validate *.html offline.html partials/*.html partials/contact/*.html",
    "validate:html:dist": "html-validate .dist-staging/*.html .dist-staging/offline.html"
  },
  "keywords": [
    "portfolio",
    "arcade",
    "developer"
  ],
  "author": "Joris",
  "license": "LicenseRef-LICENSE",
  "dependencies": {
    "clean-css": "^5.3.3",
    "sharp": "^0.34.4",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.0",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/rajdhani": "^5.2.7",
    "@fontsource/vt323": "^5.2.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "html-validate": "^9.7.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "serve": "^14.2.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "http-cache-semantics": "^4.1.1",
    "semver-regex": "^4.0.5",
    "got": "^11.8.6",
    "tmp": ">=0.2.6"
  }
}
